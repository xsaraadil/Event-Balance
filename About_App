    <script>
        function switchLanguage(lang) {
            // Reset all buttons
            document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));

            // Hide all content
            document.querySelectorAll('.content').forEach(c => c.classList.remove('active'));

            // Activate selected
            if (lang === 'ar') {
                document.querySelectorAll('.lang-btn')[0].classList.add('active');
                document.getElementById('arabic').classList.add('active');
                document.documentElement.dir = 'rtl';
                document.documentElement.lang = 'ar';
            } else if (lang === 'en') {
                document.querySelectorAll('.lang-btn')[1].classList.add('active');
                document.getElementById('english').classList.add('active');
                document.documentElement.dir = 'ltr';
                document.documentElement.lang = 'en';
            } else {
                document.querySelectorAll('.lang-btn')[2].classList.add('active');
                document.getElementById('french').classList.add('active');
                document.documentElement.dir = 'ltr';
                document.documentElement.lang = 'fr';
            }
        }

        function toggleFAQ(element) {
            const answer = element.nextElementSibling;
            answer.classList.toggle('show');
            const arrow = element.querySelector('span:last-child');
            arrow.textContent = answer.classList.contains('show') ? '▲' : '▼';
        }
    </script>
