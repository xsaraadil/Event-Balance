<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ميزان المواقف - عن التطبيق</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', 'Tahoma', 'Cairo', sans-serif;
            background: linear-gradient(135deg, #6C63FF 0%, #4A42D4 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
            background: white;
            border-radius: 40px;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }

        /* Language Switcher */
        .lang-switch {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 20px 20px 0 20px;
            background: white;
        }

        .lang-btn {
            background: #f1f5f9;
            border: none;
            padding: 8px 20px;
            border-radius: 30px;
            color: #1e293b;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 14px;
        }

        .lang-btn.active {
            background: linear-gradient(135deg, #6C63FF, #4A42D4);
            color: white;
        }

        .lang-btn:hover {
            transform: scale(1.05);
            background: #e2e8f0;
        }

        /* Content Sections */
        .content { display: none; padding: 40px 50px 50px 50px; }
        .content.active { display: block; animation: fadeIn 0.5s ease; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Header */
        .header { text-align: center; margin-bottom: 40px; }

        .logo {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, #6C63FF, #4A42D4);
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            box-shadow: 0 10px 25px -5px rgba(108, 99, 255, 0.4);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        .logo span { font-size: 56px; }

        h1 {
            font-size: 42px;
            background: linear-gradient(135deg, #6C63FF, #4A42D4);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 15px;
        }

        .version {
            display: inline-block;
            background: #e2e8f0;
            padding: 5px 15px;
            border-radius: 30px;
            font-size: 14px;
            color: #64748b;
            margin-bottom: 15px;
        }

        .tagline {
            font-size: 18px;
            color: #4a5568;
            line-height: 1.6;
            max-width: 700px;
            margin: 0 auto;
        }

        /* Sections */
        .section { margin: 50px 0; }

        .section-title {
            font-size: 28px;
            color: #1e293b;
            margin-bottom: 25px;
            padding-bottom: 10px;
            border-bottom: 3px solid #6C63FF;
            display: inline-block;
        }

        /* Features Grid */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 25px;
            margin: 30px 0;
        }

        .feature-card {
            background: #f8fafc;
            border-radius: 20px;
            padding: 25px;
            transition: all 0.3s ease;
            border: 1px solid #e2e8f0;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -12px rgba(0, 0, 0, 0.1);
            border-color: #6C63FF;
        }

        .feature-icon { font-size: 40px; margin-bottom: 15px; }

        .feature-card h3 {
            font-size: 18px;
            color: #1e293b;
            margin-bottom: 10px;
        }

        .feature-card p {
            color: #64748b;
            line-height: 1.6;
            font-size: 14px;
        }

        /* Tech Stack */
        .tech-stack {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin: 20px 0;
        }

        .tech-item {
            background: linear-gradient(135deg, #6C63FF15, #4A42D415);
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 14px;
            color: #4a5568;
            border: 1px solid #6C63FF30;
        }

        /* Stats */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 20px;
            text-align: center;
            margin: 30px 0;
        }

        .stat-card {
            background: linear-gradient(135deg, #f8fafc, #f1f5f9);
            border-radius: 20px;
            padding: 25px;
        }

        .stat-number {
            font-size: 32px;
            font-weight: bold;
            background: linear-gradient(135deg, #6C63FF, #4A42D4);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .stat-label {
            color: #64748b;
            font-size: 14px;
            margin-top: 8px;
        }

        /* Info Table */
        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            background: #f8fafc;
            border-radius: 16px;
            overflow: hidden;
        }

        .info-table td {
            padding: 15px 20px;
            border-bottom: 1px solid #e2e8f0;
        }

        .info-table tr:last-child td { border-bottom: none; }

        .info-table td:first-child {
            font-weight: 600;
            color: #4A42D4;
            width: 200px;
            background: #f1f5f9;
        }

        /* FAQ */
        .faq-item {
            margin: 15px 0;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 15px;
        }

        .faq-question {
            font-weight: bold;
            color: #1e293b;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .faq-question:hover { color: #6C63FF; }

        .faq-answer {
            color: #64748b;
            padding-top: 10px;
            display: none;
            font-size: 14px;
            line-height: 1.6;
        }

        .faq-answer.show { display: block; }

        /* CTA */
        .cta-section {
            text-align: center;
            margin: 40px 0 20px;
            padding: 40px;
            background: linear-gradient(135deg, #6C63FF, #4A42D4);
            border-radius: 30px;
            color: white;
        }

        .cta-section h3 { font-size: 24px; margin-bottom: 15px; }
        .cta-section p { opacity: 0.9; margin-bottom: 20px; }

        .cta-button {
            display: inline-block;
            background: white;
            color: #6C63FF;
            font-size: 16px;
            font-weight: 600;
            padding: 12px 30px;
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .cta-button:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }

        /* Footer */
        .footer {
            text-align: center;
            padding-top: 40px;
            margin-top: 40px;
            border-top: 1px solid #e2e8f0;
            color: #94a3b8;
            font-size: 13px;
        }

        @media (max-width: 768px) {
            .content { padding: 30px 20px; }
            h1 { font-size: 28px; }
            .section-title { font-size: 22px; }
            .info-table td:first-child { width: auto; }
        }
    </style>
</head>
